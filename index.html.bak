<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0b1120">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>SharksVsDolphins</title>
  <link rel="manifest" href="manifest.json">
  <link rel="icon" type="image/svg+xml" href="icon.svg">
  <link rel="apple-touch-icon" href="icon.svg">
  <style>
    :root {
      --bg: #020617;
      --panel: rgba(15, 23, 42, 0.72);
      --accent: #38bdf8;
      --text: #e2e8f0;
      --muted: #94a3b8;
      --dolphin: #22d3ee;
      --shark: #f87171;
      --radius: 20px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 24px 16px;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      background: linear-gradient(180deg, #0c4a6e 0%, #075985 18%, #0e3a5c 40%, #082f49 62%, #051c30 82%, #010914 100%);
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -3;
      background-image:
        radial-gradient(circle at 15% 20%, rgba(56, 189, 248, 0.10) 0%, transparent 40%),
        radial-gradient(circle at 85% 60%, rgba(34, 211, 238, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 50% 90%, rgba(2, 132, 199, 0.12) 0%, transparent 50%);
      pointer-events: none;
    }
    .waves {
      position: fixed;
      left: 0;
      width: 100%;
      z-index: -2;
      pointer-events: none;
      opacity: 0.5;
    }
    .waves.wave1 { top: 8%; animation: driftLeft 34s linear infinite; }
    .waves.wave2 { top: 34%; opacity: 0.35; animation: driftRight 46s linear infinite; }
    .waves.wave3 { top: 64%; opacity: 0.3; animation: driftLeft 58s linear infinite; }
    .waves svg { width: 200%; height: 90px; display: block; }
    @keyframes driftLeft { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes driftRight { from { transform: translateX(-50%); } to { transform: translateX(0); } }
    .bubbles {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .bubble {
      position: absolute;
      bottom: -40px;
      border-radius: 50%;
      background: rgba(224, 242, 254, 0.18);
      border: 1px solid rgba(224, 242, 254, 0.25);
      animation: floatUp linear infinite;
    }
    @keyframes floatUp {
      0% { transform: translateY(0) translateX(0); opacity: 0; }
      10% { opacity: 0.6; }
      100% { transform: translateY(-115vh) translateX(20px); opacity: 0; }
    }
    h1 {
      font-size: clamp(1.4rem, 5vw, 2rem);
      margin-bottom: 20px;
      text-align: center;
      font-weight: 800;
      letter-spacing: -0.03em;
      background: linear-gradient(90deg, var(--dolphin), var(--accent), var(--shark));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .panel {
      background: var(--panel);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
      width: 100%;
      max-width: 680px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .field { display: flex; flex-direction: column; }
    label {
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 6px;
      color: var(--muted);
      font-weight: 600;
    }
    input[type="number"] {
      padding: 10px 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 12px;
      font-size: 1rem;
      background: rgba(2, 6, 23, 0.6);
      color: var(--text);
      outline: none;
    }
    .full { grid-column: span 2; }
    .hint {
      font-size: 0.85rem;
      color: var(--muted);
      text-align: center;
      margin-top: 12px;
    }
    .controls { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; justify-content: center; }
    button {
      padding: 12px 22px;
      border: none;
      border-radius: 999px;
      background: linear-gradient(135deg, #0ea5e9, #2563eb);
      color: #fff;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(14, 165, 233, 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    button:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 22px rgba(14, 165, 233, 0.5); }
    button:active:not(:disabled) { transform: translateY(0); }
    button:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
    button.school {
      background: linear-gradient(135deg, #facc15, #f97316);
      box-shadow: 0 4px 16px rgba(250, 204, 21, 0.4);
    }
    button.school:hover:not(:disabled) { box-shadow: 0 6px 22px rgba(250, 204, 21, 0.55); }
    button.school.ready {
      font-size: 1.15rem;
      padding: 16px 32px;
      animation: schoolPulse 1.1s ease-in-out infinite;
    }
    @keyframes schoolPulse {
      0%, 100% { transform: scale(1); box-shadow: 0 4px 16px rgba(250, 204, 21, 0.45); }
      50% { transform: scale(1.08); box-shadow: 0 8px 32px rgba(250, 204, 21, 0.85); }
    }
    .canvas-wrap {
      position: relative;
      padding: 10px;
      border-radius: var(--radius);
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.8), rgba(2, 6, 23, 0.9));
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .canvas-wrap:fullscreen {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: #020617;
      width: 100vw;
      height: 100vh;
    }
    .canvas-wrap:fullscreen canvas {
      width: min(96vw, 96vh);
      height: min(96vw, 96vh);
      max-width: none;
    }
    .canvas-wrap:fullscreen .dpad {
      position: fixed;
      bottom: 24px;
      right: 24px;
    }
    .canvas-wrap:fullscreen .stats {
      display: none;
    }
    .canvas-wrap:fullscreen {
      padding: 0;
    }
    .game-controls {
      margin-top: 0;
      margin-bottom: 12px;
      gap: 8px;
    }
    .game-controls button {
      padding: 8px 14px;
      font-size: 0.82rem;
    }
    .canvas-wrap:fullscreen .game-controls {
      position: fixed;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      margin: 0;
      z-index: 5;
      background: rgba(2, 6, 23, 0.55);
      backdrop-filter: blur(8px);
      padding: 8px 10px;
      border-radius: 999px;
    }
    canvas {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 14px;
      background: #020617;
      box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.6);
      touch-action: none;
    }
    .dpad {
      display: grid;
      grid-template-columns: 56px 56px 56px;
      grid-template-rows: 56px 56px 56px;
      gap: 6px;
      justify-content: center;
      margin-top: 16px;
      user-select: none;
    }
    .dpad-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 14px;
      font-size: 1.4rem;
      color: #fff;
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
    }
    .dpad-btn.active { background: rgba(56, 189, 248, 0.35); }
    .dpad-up { grid-column: 2; grid-row: 1; }
    .dpad-left { grid-column: 1; grid-row: 2; }
    .dpad-right { grid-column: 3; grid-row: 2; }
    .dpad-down { grid-column: 2; grid-row: 3; }
    .stats {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 14px;
      max-width: 200px;
      margin-left: auto;
      margin-right: auto;
    }
    .stat-hidden {
      display: none;
    }
    .stat {
      text-align: center;
      padding: 12px 8px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
    .stat-value {
      display: block;
      font-size: 1.4rem;
      font-weight: 800;
      margin-top: 4px;
      color: #fff;
    }
    .stat.dolphin .stat-value { color: var(--dolphin); text-shadow: 0 0 12px rgba(34, 211, 238, 0.45); }
    .stat.shark .stat-value { color: var(--shark); text-shadow: 0 0 12px rgba(248, 113, 113, 0.45); }
    .info {
      font-size: 0.8rem;
      color: var(--muted);
      line-height: 1.5;
      text-align: center;
    }
    @media (max-width: 480px) {
      .grid { grid-template-columns: 1fr; }
      .full { grid-column: span 1; }
      .stats { grid-template-columns: 1fr; }
      body { padding: 16px 12px; }
    }
  </style>
</head>
<body>
  <div class="waves wave1"><svg viewBox="0 0 1600 90" preserveAspectRatio="none"><path d="M0,45 C200,90 400,0 600,45 C800,90 1000,0 1200,45 C1400,90 1600,0 1800,45 C2000,90 2200,0 2400,45 C2600,90 2800,0 3000,45 C3200,90 3200,90 3200,90 L3200,90 L0,90 Z" fill="#38bdf8"/></svg></div>
  <div class="waves wave2"><svg viewBox="0 0 1600 90" preserveAspectRatio="none"><path d="M0,45 C200,0 400,90 600,45 C800,0 1000,90 1200,45 C1400,0 1600,90 1800,45 C2000,0 2200,90 2400,45 C2600,0 2800,90 3000,45 C3200,0 3200,0 3200,0 L3200,90 L0,90 Z" fill="#0ea5e9"/></svg></div>
  <div class="waves wave3"><svg viewBox="0 0 1600 90" preserveAspectRatio="none"><path d="M0,45 C200,90 400,0 600,45 C800,90 1000,0 1200,45 C1400,90 1600,0 1800,45 C2000,90 2200,0 2400,45 C2600,90 2800,0 3000,45 C3200,90 3200,90 3200,90 L3200,90 L0,90 Z" fill="#22d3ee"/></svg></div>
  <div class="bubbles" id="bubbles"></div>

  <h1>SharksVsDolphins</h1>

  <div class="panel">
    <div class="grid">
      <div class="field">
        <label for="numSharks">Number of sharks</label>
        <input id="numSharks" type="number" value="8" min="1" max="30">
      </div>
      <div class="field">
        <label for="sharkSpeed">Shark speed</label>
        <input id="sharkSpeed" type="number" value="1" min="1" max="5">
      </div>
      <div class="field full">
        <label for="speed">Game speed (ms per frame)</label>
        <input id="speed" type="number" value="80" min="20" max="500">
      </div>
    </div>
    <div class="hint">Use the arrow keys, WASD, or the on-screen D-pad to swim. On mobile you can also touch and hold anywhere on the water; the dolphin swims in that direction relative to the centre of the screen. Swim off the left or right edge to wrap around to the other side, Pac-Man style. Avoid the sharks.</div>
  </div>

  <div class="panel canvas-wrap" id="canvasWrap">
    <div class="controls game-controls">
      <button id="startBtn" onclick="start()">Start</button>
      <button class="secondary" onclick="reset()">Reset</button>
      <button id="schoolBtn" class="school" onclick="toggleSchool()" disabled>School (needs 5 dolphins)</button>
      <button id="fullscreenBtn" class="secondary" onclick="toggleFullscreen()">Fullscreen</button>
    </div>
    <canvas id="simCanvas" width="600" height="600"></canvas>
    <div class="dpad" id="dpad">
      <div class="dpad-btn dpad-up" data-key="ArrowUp">▲</div>
      <div class="dpad-btn dpad-left" data-key="ArrowLeft">◀</div>
      <div class="dpad-btn dpad-right" data-key="ArrowRight">▶</div>
      <div class="dpad-btn dpad-down" data-key="ArrowDown">▼</div>
    </div>
    <div class="stats">
      <div class="stat"><div class="stat-label">Time</div><span class="stat-value" id="statTime">0.0s</span></div>
      <div class="stat stat-hidden"><div class="stat-label">Spawn</div><span class="stat-value" id="statSpawn">60.0s</span></div>
      <div class="stat stat-hidden"><div class="stat-label">Shrimp</div><span class="stat-value" id="statShrimp">120.0s</span></div>
      <div class="stat dolphin stat-hidden"><div class="stat-label">Dolphins</div><span class="stat-value" id="statDolphins">1</span></div>
      <div class="stat shark stat-hidden"><div class="stat-label">Sharks</div><span class="stat-value" id="statSharks">0</span></div>
      <div class="stat stat-hidden"><div class="stat-label">Status</div><span class="stat-value" id="statStatus" style="font-size: 0.85rem; font-weight: 700;">Ready</span></div>
    </div>
  </div>

  <div class="panel info">
    Swim as the dolphin, avoid sharks, meet other dolphins to grow your pod, and watch for the magic shrimp at 2 minutes.
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then(regs => regs.forEach(r => r.unregister())).catch(err => console.warn('SW unregister failed:', err));
    }

    const SIZE = 100;
    const canvas = document.getElementById('simCanvas');
    const ctx = canvas.getContext('2d');

    function wrapX(x) {
      return ((x % SIZE) + SIZE) % SIZE;
    }
    function clampY(y) {
      return Math.min(SIZE - 1, Math.max(0, y));
    }
    ctx.imageSmoothingEnabled = false;

    const keys = {};
    let environment = [];
    let dolphins = [];
    let sharks = [];
    let player = null;
    let running = false;
    let timer = null;
    let startTime = 0;
    let gameTime = 0;
    let secondDolphinSpawned = false;
    let reproduceTimer = 0;
    let lastFrameTime = 0;
    let magicShrimp = null;
    let shrimpSpawned = false;
    let schoolMode = false;
    let pointerActive = false;
    let pointerDirX = 0;
    let pointerDirY = 0;
    let envCanvas = null;
    let envCtx = null;
    let imgData = null;

    class Dolphin {
      constructor(i, y, x) {
        this.id = i;
        this._x = x;
        this._y = y;
        this.isPlayer = false;
        this.speedBoostUntil = 0;
        this.invulnerableUntil = 0;
        this.matableAfter = 0;
      }

      move() {
        if (this.isPlayer) return;

        const podBoosted = player && Date.now() < player.speedBoostUntil;
        const boostMult = podBoosted ? 2 : 1;

        const avoidRadius = 20;
        let nearestShark = null;
        let nearestDist = Infinity;
        for (const shark of sharks) {
          const d = this.distanceBetween(shark);
          if (d < nearestDist) {
            nearestDist = d;
            nearestShark = shark;
          }
        }

        if (nearestShark && nearestDist <= avoidRadius) {
          const dx = Math.sign(this._x - nearestShark._x) || (Math.random() < 0.5 ? 1 : -1);
          const dy = Math.sign(this._y - nearestShark._y) || (Math.random() < 0.5 ? 1 : -1);
          this._x = wrapX(this._x + dx * 2 * boostMult);
          this._y = clampY(this._y + dy * 2 * boostMult);
        } else {
          if (Math.random() < 0.33) this._y = clampY(this._y + 1 * boostMult);
          else this._y = clampY(this._y - 1 * boostMult);

          if (Math.random() < 0.33) this._x = wrapX(this._x + 1 * boostMult);
          else this._x = wrapX(this._x - 1 * boostMult);
        }
      }

      distanceBetween(other) {
        return Math.sqrt((this._x - other._x) ** 2 + (this._y - other._y) ** 2);
      }
    }

    class Shark {
      constructor(i) {
        this.id = i;
        this._x = Math.floor(Math.random() * 100);
        this._y = Math.floor(Math.random() * 100);
        this.sizeMultiplier = 1;
        this.speedMultiplier = 1;
      }

      move(speed) {
        if (!player) return;
        const huntRadius = 25;
        const distToPlayer = this.distanceBetween(player);

        if (distToPlayer <= huntRadius) {
          const effectiveSpeed = speed * this.speedMultiplier * 0.7;
          const dx = Math.sign(player._x - this._x);
          const dy = Math.sign(player._y - this._y);
          this._x = wrapX(this._x + dx * effectiveSpeed);
          this._y = clampY(this._y + dy * effectiveSpeed);
        } else {
          const wanderSpeed = 1 + Math.random() * 2.5;
          if (Math.random() < 0.5) {
            this._x = wrapX(this._x + (Math.random() < 0.5 ? 1 : -1) * wanderSpeed);
          }
          if (Math.random() < 0.5) {
            this._y = clampY(this._y + (Math.random() < 0.5 ? 1 : -1) * wanderSpeed);
          }
        }
      }

      distanceBetween(other) {
        return Math.sqrt((this._x - other._x) ** 2 + (this._y - other._y) ** 2);
      }
    }

    class MagicShrimp {
      constructor() {
        this._x = Math.floor(Math.random() * 100);
        this._y = Math.floor(Math.random() * 100);
      }

      distanceBetween(other) {
        return Math.sqrt((this._x - other._x) ** 2 + (this._y - other._y) ** 2);
      }
    }

    function getEnvCanvas() {
      if (!envCanvas) {
        envCanvas = document.createElement('canvas');
        envCanvas.width = SIZE;
        envCanvas.height = SIZE;
        envCtx = envCanvas.getContext('2d');
      }
      return { canvas: envCanvas, ctx: envCtx };
    }

    function createEnvironment() {
      environment = [];
      for (let y = 0; y < SIZE; y++) {
        const row = [];
        for (let x = 0; x < SIZE; x++) {
          row.push(Math.floor(Math.random() * 100));
        }
        environment.push(row);
      }
    }

    function findSafestCorner() {
      const corners = [{x: 5, y: 5}, {x: 95, y: 5}, {x: 5, y: 95}, {x: 95, y: 95}];
      let best = corners[0];
      let bestDist = 0;
      for (const c of corners) {
        let minDist = Infinity;
        for (const shark of sharks) {
          const d = Math.sqrt((shark._x - c.x) ** 2 + (shark._y - c.y) ** 2);
          if (d < minDist) minDist = d;
        }
        if (minDist > bestDist) {
          bestDist = minDist;
          best = c;
        }
      }
      return best;
    }

    function spawnSecondDolphin() {
      const corner = findSafestCorner();
      const dolphin = new Dolphin(1, corner.y, corner.x);
      dolphin.invulnerableUntil = Date.now() + 30000;
      dolphin.matableAfter = Date.now() + 30000;
      dolphins.push(dolphin);
      secondDolphinSpawned = true;
      document.getElementById('statStatus').textContent = 'Second dolphin arrived';
    }

    function init() {
      const numSharks = parseInt(document.getElementById('numSharks').value, 10) || 8;

      dolphins = [];
      const px = Math.floor(SIZE / 2);
      const py = Math.floor(SIZE / 2);
      player = new Dolphin(0, py, px);
      player.isPlayer = true;
      dolphins.push(player);

      sharks = [];
      for (let i = 0; i < numSharks; i++) {
        let sx, sy;
        do {
          sx = Math.floor(Math.random() * 100);
          sy = Math.floor(Math.random() * 100);
        } while (Math.abs(sx - px) < 15 && Math.abs(sy - py) < 15);
        sharks.push(new Shark(i));
      }

      gameTime = 0;
      startTime = 0;
      secondDolphinSpawned = false;
      reproduceTimer = 0;
      lastFrameTime = 0;
      magicShrimp = null;
      shrimpSpawned = false;
      schoolMode = false;
      document.getElementById('schoolBtn').textContent = 'School (needs 5 dolphins)';
      document.getElementById('schoolBtn').classList.remove('ready');
      updateStats();
      draw();
      return true;
    }

    function moveTowards(dolphin, tx, ty, speed) {
      const dx = Math.sign(tx - dolphin._x);
      const dy = Math.sign(ty - dolphin._y);
      dolphin._x = wrapX(dolphin._x + dx * speed);
      dolphin._y = clampY(dolphin._y + dy * speed);
    }

    function toggleSchool() {
      if (dolphins.length < 5 || schoolMode || !running) return;
      schoolMode = true;
      const schoolBtn = document.getElementById('schoolBtn');
      schoolBtn.disabled = true;
      schoolBtn.classList.remove('ready');
      schoolBtn.textContent = 'Schooling!';
      document.getElementById('statStatus').textContent = 'Schooling! Ram the sharks';
    }

    function moveSchool() {
      const boosted = Date.now() < player.speedBoostUntil;
      const followerSpeed = boosted ? 4 : 2;
      const followers = dolphins.filter(d => !d.isPlayer);
      followers.forEach((dolphin, idx) => {
        const angle = (idx / followers.length) * Math.PI * 2;
        const radius = 6;
        const tx = wrapX(player._x + Math.round(Math.cos(angle) * radius));
        const ty = clampY(player._y + Math.round(Math.sin(angle) * radius));
        moveTowards(dolphin, tx, ty, followerSpeed);
      });
    }

    function winGame() {
      running = false;
      clearTimeout(timer);
      document.getElementById('statStatus').textContent = 'You win! All sharks defeated';
      document.getElementById('startBtn').textContent = 'Restart';
      document.getElementById('schoolBtn').disabled = true;
      document.getElementById('schoolBtn').classList.remove('ready');
    }

    function movePlayer() {
      if (!player) return;
      const boosted = Date.now() < player.speedBoostUntil;
      const speed = boosted ? 4 : 2;
      let dx = 0;
      let dy = 0;

      if (pointerActive) {
        const deadZone = 0.08;
        if (Math.abs(pointerDirX) > deadZone) dx = Math.sign(pointerDirX);
        if (Math.abs(pointerDirY) > deadZone) dy = Math.sign(pointerDirY);
      } else {
        if (keys['ArrowUp'] || keys['w'] || keys['W']) dy = -1;
        if (keys['ArrowDown'] || keys['s'] || keys['S']) dy = 1;
        if (keys['ArrowLeft'] || keys['a'] || keys['A']) dx = -1;
        if (keys['ArrowRight'] || keys['d'] || keys['D']) dx = 1;
      }

      if (dx !== 0 || dy !== 0) {
        player._x = wrapX(player._x + dx * speed);
        player._y = clampY(player._y + dy * speed);
      }
    }

    function findFreeSpot() {
      let x, y;
      do {
        x = Math.floor(Math.random() * SIZE);
        y = Math.floor(Math.random() * SIZE);
      } while (player && Math.abs(x - player._x) < 10 && Math.abs(y - player._y) < 10);
      return { x, y };
    }

    function spawnMagicShrimp() {
      const spot = findFreeSpot();
      magicShrimp = new MagicShrimp();
      magicShrimp._x = spot.x;
      magicShrimp._y = spot.y;
      shrimpSpawned = true;
      document.getElementById('statStatus').textContent = 'Magic shrimp appeared!';
    }

    function checkShrimpCollection() {
      if (!magicShrimp) return;

      for (const dolphin of dolphins) {
        if (dolphin.distanceBetween(magicShrimp) <= 4) {
          if (dolphin.isPlayer) {
            dolphin.speedBoostUntil = Date.now() + 30000;
            document.getElementById('statStatus').textContent = 'Speed boost!';
          } else {
            dolphin.invulnerableUntil = Date.now() + 30000;
            document.getElementById('statStatus').textContent = 'A dolphin is invulnerable!';
          }
          magicShrimp = null;
          return;
        }
      }

      for (const shark of sharks) {
        if (shark.distanceBetween(magicShrimp) <= 4) {
          shark.sizeMultiplier = 5;
          shark.speedMultiplier = 1.25;
          document.getElementById('statStatus').textContent = 'A shark grabbed the shrimp!';
          magicShrimp = null;
          return;
        }
      }
    }

    function step() {
      if (!running) return;

      const sharkSpeed = parseInt(document.getElementById('sharkSpeed').value, 10) || 1;

      movePlayer();
      if (schoolMode) {
        moveSchool();
      } else {
        for (const dolphin of dolphins) {
          if (!dolphin.isPlayer) dolphin.move();
        }
      }

      const now = Date.now();

      for (const shark of sharks) {
        shark.move(sharkSpeed);
      }

      if (schoolMode) {
        const hitRadius = 4;
        sharks = sharks.filter(shark => {
          const hitsAnyDolphin = dolphins.some(d => shark.distanceBetween(d) < hitRadius);
          return !hitsAnyDolphin;
        });
        if (sharks.length === 0) {
          winGame();
          return;
        }
      } else {
        for (const shark of sharks) {
          const isPlayerInvulnerable = player.invulnerableUntil && now < player.invulnerableUntil;
          if (!isPlayerInvulnerable && shark.distanceBetween(player) < 4) {
            gameOver();
            return;
          }
        }
      }

      const dt = lastFrameTime === 0 ? 0 : (now - lastFrameTime) / 1000;
      lastFrameTime = now;

      if (startTime === 0) startTime = now;
      gameTime = (now - startTime) / 1000;

      if (!secondDolphinSpawned && gameTime >= 60) {
        spawnSecondDolphin();
      }

      if (!shrimpSpawned && gameTime >= 120) {
        spawnMagicShrimp();
      }

      checkShrimpCollection();

      if (reproduceTimer > 0) reproduceTimer -= dt;

      if (dolphins.length < 5 && reproduceTimer <= 0) {
        for (const dolphin of dolphins) {
          if (dolphin === player) continue;
          if (now < dolphin.matableAfter) continue;
          const dist = player.distanceBetween(dolphin);
          if (dist <= 5) {
            const nx = wrapX(dolphin._x + 3);
            const ny = clampY(dolphin._y + 3);
            const baby = new Dolphin(dolphins.length, ny, nx);
            baby.invulnerableUntil = Date.now() + 30000;
            baby.matableAfter = Date.now() + 30000;
            dolphins.push(baby);
            reproduceTimer = 2.0;
            document.getElementById('statStatus').textContent = 'New dolphin born';
            break;
          }
        }
      }

      draw();
      updateStats();

      const speed = parseInt(document.getElementById('speed').value, 10) || 80;
      timer = setTimeout(step, speed);
    }

    function start() {
      if (!init()) return;
      running = true;
      document.getElementById('startBtn').textContent = 'Restart';
      document.getElementById('statStatus').textContent = 'Swimming';
      step();
    }

    function gameOver() {
      running = false;
      clearTimeout(timer);
      document.getElementById('statStatus').textContent = 'Eaten by a shark';
      document.getElementById('startBtn').textContent = 'Restart';
      document.getElementById('schoolBtn').disabled = true;
      document.getElementById('schoolBtn').classList.remove('ready');
    }

    function reset() {
      running = false;
      clearTimeout(timer);
      createEnvironment();
      init();
      document.getElementById('statStatus').textContent = 'Ready';
      document.getElementById('startBtn').textContent = 'Start';
    }

    function updateStats() {
      document.getElementById('statTime').textContent = gameTime.toFixed(1) + 's';
      const spawnCount = Math.max(0, 60 - gameTime);
      document.getElementById('statSpawn').textContent = secondDolphinSpawned ? 'Arrived' : spawnCount.toFixed(1) + 's';
      const shrimpCount = Math.max(0, 120 - gameTime);
      document.getElementById('statShrimp').textContent = magicShrimp ? 'On the board!' : (shrimpSpawned ? 'Gone' : shrimpCount.toFixed(1) + 's');
      document.getElementById('statDolphins').textContent = dolphins.length;
      document.getElementById('statSharks').textContent = sharks.length;

      const schoolBtn = document.getElementById('schoolBtn');
      if (!schoolMode) {
        const isReady = dolphins.length >= 5 && running;
        schoolBtn.disabled = !isReady;
        schoolBtn.textContent = dolphins.length < 5 ? 'School (needs 5 dolphins)' : 'School the pod!';
        schoolBtn.classList.toggle('ready', isReady);
      }
    }

    function drawEnvironment() {
      const w = canvas.width;
      const h = canvas.height;
      const t = gameTime || 0;

      const waterGrad = ctx.createLinearGradient(0, 0, 0, h);
      waterGrad.addColorStop(0, '#0ea5e9');
      waterGrad.addColorStop(0.32, '#0284c7');
      waterGrad.addColorStop(0.68, '#075985');
      waterGrad.addColorStop(1, '#04283b');
      ctx.fillStyle = waterGrad;
      ctx.fillRect(0, 0, w, h);

      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      for (let i = 0; i < 6; i++) {
        const cx = w * (0.15 + 0.7 * ((Math.sin(t * 0.15 + i * 1.9) + 1) / 2));
        const cy = h * (0.08 + 0.16 * i + 0.04 * Math.sin(t * 0.22 + i));
        const r = w * (0.13 + 0.025 * Math.sin(t * 0.3 + i * 1.3));
        const patch = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
        patch.addColorStop(0, 'rgba(224, 242, 254, 0.12)');
        patch.addColorStop(1, 'rgba(224, 242, 254, 0)');
        ctx.fillStyle = patch;
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      ctx.save();
      ctx.strokeStyle = 'rgba(224, 242, 254, 0.10)';
      ctx.lineWidth = 2;
      for (let i = 0; i < 3; i++) {
        const yOff = h * (0.2 + i * 0.28) + Math.sin(t * 0.25 + i * 2) * 10;
        ctx.beginPath();
        for (let x = -20; x <= w + 20; x += 20) {
          const y = yOff + Math.sin((x * 0.02) + t * 0.4 + i) * 8;
          if (x === -20) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      ctx.restore();

      const sandHeight = h * 0.07;
      const sandGrad = ctx.createLinearGradient(0, h - sandHeight, 0, h);
      sandGrad.addColorStop(0, 'rgba(217, 180, 90, 0.10)');
      sandGrad.addColorStop(1, 'rgba(180, 140, 60, 0.30)');
      ctx.fillStyle = sandGrad;
      ctx.fillRect(0, h - sandHeight, w, sandHeight);
    }

    function drawAgents() {
      const scale = canvas.width / SIZE;
      const fontSize = Math.max(8, Math.floor(scale * 1.1));
      const family = '"Segoe UI Emoji", "Apple Color Emoji", "Noto Color Emoji", sans-serif';
      const now = Date.now();
      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      if (magicShrimp) {
        const cx = magicShrimp._x * scale + scale / 2;
        const cy = magicShrimp._y * scale + scale / 2;
        const pulse = 1 + Math.sin((gameTime || 0) * 6) * 0.12;
        const shrimpFont = fontSize * 5 * pulse;

        ctx.font = `${shrimpFont}px ${family}`;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(cx, cy, shrimpFont / 2, 0, Math.PI * 2);
        ctx.fill();

        ctx.shadowColor = '#facc15';
        ctx.shadowBlur = 20;
        ctx.fillText('🍤', cx, cy);
      }

      const dolphinFont = fontSize * 4;
      for (const dolphin of dolphins) {
        const cx = dolphin._x * scale + scale / 2;
        const cy = dolphin._y * scale + scale / 2;
        const boosted = now < dolphin.speedBoostUntil;
        const invulnerable = now < dolphin.invulnerableUntil;

        ctx.font = `${dolphinFont}px ${family}`;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(cx, cy, dolphinFont / 2, 0, Math.PI * 2);
        ctx.fill();

        if (boosted) {
          ctx.strokeStyle = '#facc15';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(cx, cy, dolphinFont / 2 + 4, 0, Math.PI * 2);
          ctx.stroke();
        }
        if (invulnerable) {
          ctx.strokeStyle = '#a855f7';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(cx, cy, dolphinFont / 2 + 4, 0, Math.PI * 2);
          ctx.stroke();
        }

        ctx.shadowColor = '#22d3ee';
        ctx.shadowBlur = 5;
        ctx.fillText('🐬', cx, cy);
      }

      for (const shark of sharks) {
        const cx = shark._x * scale + scale / 2;
        const cy = shark._y * scale + scale / 2;
        const sharkFont = fontSize * 8 * shark.sizeMultiplier;
        ctx.font = `${sharkFont}px ${family}`;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(cx, cy, sharkFont / 2, 0, Math.PI * 2);
        ctx.fill();

        ctx.shadowColor = '#f87171';
        ctx.shadowBlur = 5;
        ctx.fillText('🦈', cx, cy);
      }

      ctx.restore();
    }

    function draw() {
      drawEnvironment();
      drawAgents();
    }

    window.addEventListener('keydown', e => { keys[e.key] = true; });
    window.addEventListener('keyup', e => { keys[e.key] = false; });

    function toggleFullscreen() {
      const wrap = document.getElementById('canvasWrap');
      if (!document.fullscreenElement) {
        wrap.requestFullscreen().catch(err => console.warn('Fullscreen failed:', err));
      } else {
        document.exitFullscreen();
      }
    }

    document.addEventListener('fullscreenchange', () => {
      const btn = document.getElementById('fullscreenBtn');
      btn.textContent = document.fullscreenElement ? 'Exit Fullscreen' : 'Fullscreen';
    });

    document.querySelectorAll('.dpad-btn').forEach(btn => {
      const key = btn.dataset.key;
      const press = e => { e.preventDefault(); keys[key] = true; btn.classList.add('active'); };
      const release = e => { e.preventDefault(); keys[key] = false; btn.classList.remove('active'); };
      btn.addEventListener('touchstart', press, { passive: false });
      btn.addEventListener('touchend', release, { passive: false });
      btn.addEventListener('touchcancel', release, { passive: false });
      btn.addEventListener('mousedown', press);
      btn.addEventListener('mouseup', release);
      btn.addEventListener('mouseleave', release);
    });

    function updatePointerDirection(clientX, clientY) {
      const rect = canvas.getBoundingClientRect();
      pointerDirX = (clientX - rect.left) / rect.width - 0.5;
      pointerDirY = (clientY - rect.top) / rect.height - 0.5;
    }

    canvas.addEventListener('touchstart', e => {
      e.preventDefault();
      const touch = e.touches[0];
      if (!touch) return;
      pointerActive = true;
      updatePointerDirection(touch.clientX, touch.clientY);
    }, { passive: false });

    canvas.addEventListener('touchmove', e => {
      e.preventDefault();
      const touch = e.touches[0];
      if (!touch) return;
      updatePointerDirection(touch.clientX, touch.clientY);
    }, { passive: false });

    canvas.addEventListener('touchend', e => { e.preventDefault(); pointerActive = false; }, { passive: false });
    canvas.addEventListener('touchcancel', e => { e.preventDefault(); pointerActive = false; }, { passive: false });

    canvas.addEventListener('mousedown', e => {
      pointerActive = true;
      updatePointerDirection(e.clientX, e.clientY);
    });
    canvas.addEventListener('mousemove', e => {
      if (pointerActive) updatePointerDirection(e.clientX, e.clientY);
    });
    window.addEventListener('mouseup', () => { pointerActive = false; });

    createEnvironment();
    init();

    (function spawnBubbles() {
      const container = document.getElementById('bubbles');
      const count = 22;
      for (let i = 0; i < count; i++) {
        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        const size = 4 + Math.random() * 14;
        bubble.style.width = `${size}px`;
        bubble.style.height = `${size}px`;
        bubble.style.left = `${Math.random() * 100}%`;
        bubble.style.animationDuration = `${10 + Math.random() * 18}s`;
        bubble.style.animationDelay = `${Math.random() * 20}s`;
        container.appendChild(bubble);
      }
    })();
  </script>
</body>
</html>
